              },
              "size": {
                "type": "integer",
                "description": "返回数量（默认10，最大50）",
                "default": 50
              }
            },
            "required": ["query"]
          },
          "returns": {
            "type": "list[dict]",
            "fields": ["uid", "title", "publish_date", "score", "extra (organization)"]
          },
          "file_reference": "SKILL.md#L487",
          "data_source": "iwencai OpenAPI",
          "auth_required": true
        },
        {
          "name": "iwencai_query",
          "layer": 2,
          "description": "iwencai NL数据查询（结构化字段）",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "自然语言查询"
              },
              "page": {
                "type": "integer",
                "description": "页码",
                "default": 1
              },
              "limit": {
                "type": "integer",
                "description": "每页数量",
                "default": 50
              }
            },
            "required": ["query"]
          },
          "returns": {
            "type": "list[dict]",
            "fields": ["DataFrame-like rows"]
          },
          "file_reference": "SKILL.md#L515",
          "data_source": "iwencai OpenAPI",
          "auth_required": true
        }
      ]
