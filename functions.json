{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "a-stock-data",
  "description": "A股全栈数据工具包 - 29个端点函数索引",
  "version": "3.1",
  "layers": [
    {
      "id": 1,
      "name": "行情层",
      "description": "实时行情，不封IP",
      "endpoints": [
        {
          "name": "mootdx_bars",
          "layer": 1,
          "description": "mootdx K线数据（TCP 7709，连通达信服务器）",
          "parameters": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "description": "6位股票代码"
              },
              "category": {
                "type": "integer",
                "description": "K线周期（4=日线，5=周线，6=月线，7=1分钟，8=5分钟，9=15分钟，10=30分钟，11=60分钟）",
                "default": 4
              },
              "offset": {
                "type": "integer",
                "description": "返回数量",
                "default": 10
              }
            },
            "required": ["symbol"]
          },
          "returns": {
            "type": "DataFrame",
            "fields": ["open", "close", "high", "low", "vol", "amount", "datetime"]
          },
          "file_reference": "SKILL.md#L183",
          "data_source": "mootdx TCP",
          "auth_required": false
        },
        {
          "name": "tencent_quote",
          "layer": 1,
          "description": "腾讯财经实时行情（HTTP GBK，不封IP）",
          "parameters": {
            "type": "object",
            "properties": {
              "codes": {
                "type": "array",
                "items": {"type": "string"},
                "description": "6位股票代码列表，支持指数（000001/000300/399006）和ETF（510050/510300）"
              }
            },
            "required": ["codes"]
          },
          "returns": {
            "type": "dict[str, dict]",
            "fields": ["name", "price", "pe_ttm", "pb", "mcap_yi", "float_mcap_yi", "turnover_pct", "limit_up", "limit_down", "change_amt", "change_pct", "high", "low", "last_close", "open", "amplitude_pct", "vol_ratio", "pe_static"]
          },
          "file_reference": "SKILL.md#L211",
          "data_source": "腾讯财经 HTTP",
          "auth_required": false
        },
        {
          "name": "baidu_kline_with_ma",
          "layer": 1,
          "description": "百度股市通K线（自带MA5/MA10/MA20均价）",
          "parameters": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "6位股票代码"
              },
              "start_time": {
                "type": "string",
                "description": "起始时间（空字符串则返回最近）",
                "default": ""
              }
            },
            "required": ["code"]
          },
          "returns": {
            "type": "dict",
            "fields": ["keys (含 ma5avgprice, ma10avgprice, ma20avgprice)", "rows (time, open, close, high, low, volume, amount)"]
          },
          "file_reference": "SKILL.md#L313",
          "data_source": "百度股市通 HTTP",
          "auth_required": false
        }
      ]
    },
